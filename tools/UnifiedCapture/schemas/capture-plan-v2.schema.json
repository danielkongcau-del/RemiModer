{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc.capture-plan.v2",
  "type": "object",
  "required": ["schema", "plan_id", "plan_revision", "modules", "sources", "resources", "observations"],
  "properties": {
    "schema": {"const": "uc.capture-plan.v2"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 0},
    "modules": {"type": "object", "minProperties": 1},
    "sources": {"type": "object", "minProperties": 1},
    "resources": {
      "type": "object",
      "required": ["event_slots_per_observation", "call_frames_per_function", "thread_nesting_limit", "max_record_bytes"],
      "properties": {
        "event_slots_per_observation": {"type": "integer", "minimum": 1},
        "call_frames_per_function": {"type": "integer", "minimum": 1},
        "thread_nesting_limit": {"type": "integer", "minimum": 1},
        "max_record_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "backend", "module", "entry", "exit_capture_requirement", "native_exit_manifest", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "backend": {"const": "gum_function_probe_pair"},
          "module": {"type": "string", "minLength": 1},
          "entry": {
            "type": "object",
            "required": ["rva", "expected_prefix", "backend_patch_contract", "reads"],
            "properties": {
              "rva": {"type": "integer", "minimum": 0},
              "expected_prefix": {"type": "string", "pattern": "^[0-9a-f]+$", "minLength": 32},
              "backend_patch_contract": {
                "type": "object",
                "required": ["backend_build_hash", "redirect_kind", "required_redirect_span", "relocated_span", "fault_in_relocated_span_test", "architectural_rsp_test", "cet_cfg_test"],
                "properties": {
                  "backend_build_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "redirect_kind": {"enum": ["near", "far"]},
                  "required_redirect_span": {"type": "integer", "minimum": 1},
                  "relocated_span": {"type": "integer", "minimum": 1},
                  "fault_in_relocated_span_test": {"const": "passed-own-fixture"},
                  "architectural_rsp_test": {"const": "passed-own-fixture"},
                  "cet_cfg_test": {"enum": ["passed-own-fixture", "target-runtime-required", "target-runtime-observed"]}
                }
              },
              "reads": {"type": "array"}
            }
          },
          "exit_capture_requirement": {"enum": ["none", "completion", "return_value", "path_identity"]},
          "native_exit_manifest": {
            "type": "object",
            "required": ["path", "sha256", "function_id"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "function_id": {"type": "string", "minLength": 1}
            }
          },
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    },
    "physical_site_policy": {
      "type": "object",
      "required": ["exact_site_sharing", "partial_overlap"],
      "properties": {
        "exact_site_sharing": {"const": "share-one-listener-multiple-logical-subscriptions"},
        "partial_overlap": {"const": "reject"}
      }
    }
  }
}
